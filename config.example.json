{
  "_说明": "复制本文件内容到 <项目>\\data\\aw2.json 修改（默认数据目录就是项目内的 data\\，便携式：所有数据都在项目文件夹里，删除项目文件夹即彻底清空；也可用环境变量 AW2_DATA_ROOT 指到别处）。所有字段均可省略，省略即用默认值。steamApiKey 用 node src\\cli.js setkey 设置（加密存储），不要手填明文。",

  "lang": "schinese",
  "steamApiKey": "",
  "steamApiFallbackKey": "",
  "timeThreshold": 10,
  "tick": 600,
  "checkProcessRunning": false,
  "iconPrefetch": true,
  "notify": true,

  "websocket": { "enabled": true, "port": 8082, "auth": null },
  "action": { "target": "", "cwd": "", "hide": true },
  "toast": { "appId": null },

  "wall": {
    "_说明": "成就墙导出目录；dir 留空 = 默认 <数据目录>\\AchievementWall（随项目走）；enabled:false 整体关闭",
    "dir": "",
    "enabled": true
  },

  "paths": {
    "_说明": "全部可省略；数组留空 [] 用内置默认（见下），个人路径写在这里。数组按顺序取优先级。",

    "_gameSearchDirs_默认": "[]（不自动搜索）",
    "gameSearchDirs": [
      "D:\\Games",
      "E:\\SteamLibrary\\steamapps\\common"
    ],

    "_emuRoots_默认": "[<数据目录>\\tools\\steam-emu]（恒兜底）",
    "emuRoots": [
      "D:\\GameTools\\steam-emu"
    ],

    "_emuExtraSources_默认": "[]（不额外搜索）",
    "emuExtraSources": [
      "D:\\Tools\\GoldbergGUI-0.3.0\\goldberg"
    ]
  }
}
